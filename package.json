{
  "name": "tabby-better-sidebar-plus",
  "version": "2.0.2",
  "description": "Tabby 连接侧边栏增强插件（tabby-better-sidebar-plus），基于 TooMuhtsh/tabby-better-sidebar 独立扩展，新增 Linux 系统信息、SFTP 终端目录跟踪与工具栏按钮控制。",
  "keywords": [
    "tabby-plugin",
    "tabby",
    "terminal",
    "ssh",
    "sidebar",
    "sftp",
    "sftp-client",
    "sftp-browser",
    "file-manager",
    "file-browser",
    "file-transfer",
    "ftp",
    "ssh-tunnel",
    "port-forwarding",
    "tunneling",
    "connection-manager",
    "profile-manager",
    "favorites",
    "bookmarks",
    "drag-and-drop",
    "workspace",
    "workspaces",
    "icon-picker",
    "icons",
    "snippets",
    "notes",
    "transfer-manager",
    "connection-status",
    "better-tabby",
    "tabby-better-sidebar-plus",
    "better-sidebar-plus",
    "linux-system-info",
    "sftp-directory-tracking",
    "系统信息",
    "SFTP目录跟踪"
  ],
  "main": "dist/index.js",
  "typings": "dist/src/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wzwwzb/tabby-better-sidebar-plus.git"
  },
  "homepage": "https://github.com/wzwwzb/tabby-better-sidebar-plus#readme",
  "bugs": {
    "url": "https://github.com/wzwwzb/tabby-better-sidebar-plus/issues"
  },
  "scripts": {
    "build": "webpack --progress --color",
    "build:prod": "webpack --progress --color --mode production && node scripts/strip-source-maps.js",
    "watch": "webpack --progress --color --watch",
    "test:text-document": "node scripts/test-text-document-tools.js",
    "lint:airules": "html-validate \".AIRules/**/*.html\"",
    "lint:i18n": "node scripts/lint-i18n.js",
    "prepublishOnly": "npm run build:prod"
  },
  "files": [
    "dist",
    "README.fr.md",
    "README.en.md",
    "THIRD-PARTY-NOTICES.md",
    "CHANGELOG.md"
  ],
  "author": "wzwwzb (fork of TooMuhtsh/tabby-better-sidebar)",
  "license": "MIT",
  "devDependencies": {
    "@angular/animations": "^15.0.0",
    "@angular/cdk": "^15.0.0",
    "@angular/common": "^15.0.0",
    "@angular/core": "^15.0.0",
    "@angular/forms": "^15.0.0",
    "@angular/platform-browser": "^15.0.0",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify-json/tabler": "^1.2.37",
    "@ng-bootstrap/ng-bootstrap": "^14.2.0",
    "@types/node": "^18.19.0",
    "@types/webpack-env": "^1.16.0",
    "@xmldom/xmldom": "^0.9.12",
    "apply-loader": "^2.0.0",
    "css-loader": "^6.8.0",
    "dompurify": "^3.4.12",
    "filesize": "^11.0.22",
    "fuzzy-search": "^3.2.1",
    "html-validate": "^11.6.0",
    "parse5": "^7.3.0",
    "pug": "^2.0.4",
    "pug-loader": "^2.4.0",
    "rxjs": "^7.3.0",
    "sass": "^1.60.0",
    "sass-loader": "^13.2.0",
    "style-loader": "^3.3.0",
    "tabby-core": "^1.0.231-nightly.0",
    "tabby-settings": "^1.0.231-nightly.0",
    "tabby-terminal": "^1.0.231-nightly.0",
    "ts-loader": "^9.4.0",
    "typescript": "^4.9.5",
    "webpack": "^5.24.4",
    "webpack-cli": "^4.5.0",
    "yaml": "^2.9.1"
  }
}
